      "cuv": 4,
      "opsPerRound": 8388608,
      "fullRounds": 50000,
      "probeRounds": 50000
    },
    "allowanceSeconds": 4,
    "tolerancePercent": 10,
    "figuresStatus": "placeholders (OD16) to be calibrated on bare metal: A of a few seconds against the shortest honest run, T 10 %",
