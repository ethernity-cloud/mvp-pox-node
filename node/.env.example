# The agent's settings, as node/.env sets them (config.py loads .env from the
# working directory, node/; a variable the environment already carries wins).
# node/.env is the release's file and carries no key: the wallet keys come
# from the operator's config through the start script's arguments. Every
# per-network variable is <PREFIX>_<FIELD>, the prefix the network's name
# upper-cased (POLYGON_MAINNET, POLYGON_AMOY, POLYGON_AMOY_UNSAFE,
# BLOXBERG_MAINNET, BLOXBERG_TESTNET, BLOXBERG_TESTNET_UNSAFE, IOTEX_TESTNET,
# ETHEREUM_SEPOLIA, ETHEREUM_SEPOLIA_UNSAFE, LITVM_LITEFORGE,
# LITVM_LITEFORGE_UNSAFE: config.NETWORKS); the start script maps the same
# names from the operator's config to --<network>_<field> arguments, which
# override the file. The block below gives polygon_amoy in full; every other
# network takes the same fields under its prefix, with its own values.

# The release: logged at start ("Initializing Ethernity CLOUD Agent v...")
# and posted by the heartbeat as v<VERSION>.
VERSION=3.8.0

# --- Process-wide settings ----------------------------------------------------

# Kubo: the peers to keep (comma-separated multiaddrs), the API, the HTTP
# gateway a download falls back to, the API timeout in seconds.
IPFS_SWARM=/dns4/ipfs.ethernity.cloud/tcp/4001/p2p/QmRBc1eBt4hpJQUqHqn6eA8ixQPD3LFcUDsn6coKBQtia5
IPFS_CONNECT_URL=/ip4/127.0.0.1/tcp/5001/http
IPFS_GATEWAY_URL=https://ipfs.ethernity.cloud
IPFS_TIMEOUT=30
# The Kubo release the agent installs when the daemon is missing or older.
KUBO_URL=<kubo tarball url>
KUBO_VERSION=<kubo version>
# How long a pinned object (days) and an extracted enclave image tree (days)
# are kept once nothing needs them; 0 disables the sweep. The sweep runs at
# most every IPFS_CLEANUP_INTERVAL_MINUTES, the validators' IPFS peering is
# refreshed every IPFS_PEER_SYNC_SECONDS.
IPFS_PIN_RETENTION_DAYS=7
IMAGE_TREE_RETENTION_DAYS=2
IPFS_CLEANUP_INTERVAL_MINUTES=60
IPFS_PEER_SYNC_SECONDS=300
# How many image trees' enclave images docker keeps; how long (seconds) the
# securelock container waits for the trustedzone's enclave, 0 for no wait.
ENCLAVE_IMAGE_TREES_KEPT=5
ENCLAVE_START_STAGGER_SECONDS=90
# True runs every trustedzone without an integration test (debugging only).
SKIP_INTEGRATION_TEST=False
# debug logs every tick; anything else logs at INFO (/var/log/etny-node.log).
LOG_LEVEL=info
# Seconds between the heartbeat contract calls.
CONTRACT_CALL_FREQUENCY=43200
# The relay gas budget (wei of the gas token) of a legacy order on a network
# without <NETWORK>_ESR_RELAY_GAS_BUDGET_WEI; a 1.2 order's budget is the
# order's own chain fee.
ESR_RELAY_GAS_BUDGET_WEI=100000000000000000

# Replication (every agent; the mirror runs it alone): the round's cadence,
# the free disk kept, the scan windows and the pin bounds.
ESR_REPLICATION_INTERVAL_SECONDS=300
ESR_MIN_FREE_STORAGE_GB=10
ESR_SCAN_LOOKBACK_BLOCKS=50000
ESR_RESULT_SCAN_ORDERS=200
DO_REQUEST_SCAN_REQUESTS=200
ESR_PIN_ATTEMPTS_PER_CYCLE=2
ESR_PIN_MAX_ATTEMPTS=10
ESR_PIN_ATTEMPT_TIMEOUT_SECONDS=30
ESR_STAGE_FETCH_SECONDS=120
SESSION_INPUT_FETCH_SECONDS=30
CAS_SESSION_REGISTRY_SCAN_BLOCKS=200000
IMAGE_REGISTRY_SCAN_BLOCKS=200000
REGISTERED_IMAGE_PIN_TIMEOUT_SECONDS=3600
REGISTERED_IMAGE_PIN_STALL_SECONDS=300
REGISTERED_IMAGE_VERIFY_TIMEOUT_SECONDS=900
REGISTERED_IMAGE_MAX_BYTES=3221225472
REGISTERED_COMPOSE_MAX_BYTES=1048576
REGISTERED_IMAGE_SCAN_MAX_BYTES=1073741824
REGISTERED_IMAGE_INFLATE_MAX_BYTES=2147483648
# Seconds a CAS endpoint probe may take when the CAS is resolved from chain.
CAS_RESOLVER_PROBE_TIMEOUT=10
# Kubo's garbage collection runs after the pin sweep; 0 (or false) skips it.
IPFS_PERIODIC_GC=1
# The floor the agent raises Kubo's Datastore.StorageMax to at start; a
# higher value is kept.
IPFS_STORAGE_MAX=10GB

# The mirror (the bootnode): no SGX, no DP request, no transaction; the
# payload intake when IPFS_INTAKE_BIND is set.
REPLICATION_ONLY=False
IPFS_INTAKE_BIND=
IPFS_INTAKE_MAX_BYTES=104857600
IPFS_INTAKE_RETENTION_SECONDS=86400

# The ethernity-cas contracts of a network (config.py holds the deployed
# addresses, given below; a variable overrides one). The names are not
# <PREFIX>_<FIELD> throughout: an -unsafe network reads its parent's names
# (polygon_amoy_unsafe the POLYGON_AMOY_* ones), the bloxberg networks read
# CAS_SESSION_REGISTRY_ADDRESS, VALIDATOR_REGISTRY_ADDRESS and
# IPFS_ENDPOINTS_ADDRESS without a prefix, and ESR_CONTRACT_ADDRESS is read
# by every network but the Amoy pair (bloxberg mainnet 0x4Bf5cDE3..., bloxberg
# testnet and its twin 0x0Ea1728E..., litvm 0x709052Fe..., sepolia
# 0x9927809B...), so one value moves them all; it stays unset here.
POLYGON_AMOY_ESR_CONTRACT_ADDRESS=0x1DC58496ed1cA66FD1E0b51fA28A9E7451970843
POLYGON_AMOY_CAS_SESSION_REGISTRY_ADDRESS=0x059662030fEeB4Ea8Fc7b05951A578d527a827e5
POLYGON_AMOY_VALIDATOR_REGISTRY_ADDRESS=0x48079D66B39cD3213587d3b5300BCEc401df6676
POLYGON_AMOY_IPFS_ENDPOINTS_ADDRESS=0x510172C5Ca277fF1291c83cD772a27D801a79d62
# bloxberg_testnet (the registries also serve bloxberg_testnet_unsafe).
CAS_SESSION_REGISTRY_ADDRESS=0x78f0c5E92E7A9Ec2f2A36A4509ED4a75D0f9463B
VALIDATOR_REGISTRY_ADDRESS=0x8CC8B1dc22f0E06193161CeC79d75987b0640e02
IPFS_ENDPOINTS_ADDRESS=0x8eF996f77a2A42D60df40F8b4e8239E1042FF1A1
# litvm_liteforge and litvm_liteforge_unsafe.
LITVM_LITEFORGE_CAS_SESSION_REGISTRY_ADDRESS=0xfA70B5Df7C773A21164cAc5413704117e4dEaB76
LITVM_LITEFORGE_VALIDATOR_REGISTRY_ADDRESS=0xbE3759f327e8643fC5A1717fb2072A0dAcBAD29E
LITVM_LITEFORGE_IPFS_ENDPOINTS_ADDRESS=0x145E7eb7aa06F616b04Dca1ad6DE834d80a35270
# ethereum_sepolia and ethereum_sepolia_unsafe.
ETHEREUM_SEPOLIA_CAS_SESSION_REGISTRY_ADDRESS=0xDbB249E108d19fC1691483Bf897bA8BA0dA99c06
ETHEREUM_SEPOLIA_VALIDATOR_REGISTRY_ADDRESS=0x8ad24b3F406A41a0F8D3440021792EB203957F43
ETHEREUM_SEPOLIA_IPFS_ENDPOINTS_ADDRESS=0x70bfdf41D4061592DF509b9b46F91a8457F88483

# --- One network: polygon_amoy (config.NetworkConfig) -------------------------

# MAINNET or TESTNET.
POLYGON_AMOY_NETWORK_TYPE=TESTNET
POLYGON_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Milliseconds between RPC calls; the chain's block time in seconds.
POLYGON_AMOY_RPC_DELAY=<ms>
POLYGON_AMOY_CHAIN_ID=80002
POLYGON_AMOY_BLOCK_TIME=2
# The protocol (PoX) contract. Amoy's is the 1.2 implementation since 3.8.0
# (the trustedzones bake it and the validators judge against it); every
# network's -unsafe twin names the network's chain and contract.
POLYGON_AMOY_CONTRACT_ADDRESS=0x3Aa1A0d7A8A9DaE9e13345D3261afe86D67326A4
POLYGON_AMOY_HEARTBEAT_CONTRACT_ADDRESS=<address>
POLYGON_AMOY_IMAGE_REGISTRY_CONTRACT_ADDRESS=<address>
# The token the rewards are logged in; the unit of the gas settings below
# (gwei, wei).
POLYGON_AMOY_TOKEN_NAME=<token>
POLYGON_AMOY_GAS_PRICE_MEASURE=<gwei or wei>
# The gas-token balance (wei) the node wallet needs to start, and the node's
# price per hour (legacy requests' uint8 price; a 1.2 bid is the pricing's
# quote plus the tip).
POLYGON_AMOY_MINIMUM_GAS_AT_START=100000000000000000
POLYGON_AMOY_TASK_EXECUTION_PRICE=<price>
# The trustedzones the network runs, "name:requirement" (dcap, or sgx for the
# -unsafe trustedzones), and the ones whose integration test the node runs.
POLYGON_AMOY_TRUSTEDZONE_IMAGES=<name:dcap,...>
POLYGON_AMOY_INTEGRATION_TEST_IMAGES=<name,...>
# EIP-1559 fees (the priority fee and the ceiling, in GAS_PRICE_MEASURE) or
# the legacy gas price; the gas limit of a transaction; geth_poa injects the
# POA middleware.
POLYGON_AMOY_EIP1559=<True or False>
POLYGON_AMOY_MIDDLEWARE=<geth_poa or empty>
POLYGON_AMOY_GAS_PRICE=<legacy gas price>
POLYGON_AMOY_GAS_LIMIT=<gas>
POLYGON_AMOY_MAX_PRIORITY_FEE_PER_GAS=<priority fee>
POLYGON_AMOY_MAX_FEE_PER_GAS=<fee ceiling>
# How the legacy reward is logged: 1 takes the fees out of the price, 2 adds
# them on top; the network's and the enclaves' fee percents.
POLYGON_AMOY_REWARD_TYPE=<1 or 2>
POLYGON_AMOY_NETWORK_FEE=<percent>
POLYGON_AMOY_ENCLAVE_FEE=<percent>
# The relay gas budget (wei) of a legacy order on this network.
POLYGON_AMOY_ESR_RELAY_GAS_BUDGET_WEI=1000000000000000000

# The 1.2 settings (3.8.0), each optional:
# the operator's tip in token wei per CU-hour, added to the gas the node prices
# into its DP request (0: the node's own gas alone);
POLYGON_AMOY_TIP_PER_CU_HOUR_WEI=0
# whether the offer accepts the reserved orders the reservation broker places
# (true/false, 1/0); 0 keeps the node on spot orders;
POLYGON_AMOY_ACCEPT_RESERVED=true
# a farm owner's invitation "<farm>:<expiresAt>:<signature>", joined at start
# with joinFarm; empty for none;
POLYGON_AMOY_FARM_INVITE=
# whether the node accepts the handovers its farm's members announce.
POLYGON_AMOY_FARM_ACCEPT=true

# polygon_amoy_unsafe: the same chain and contract, the network's -unsafe
# trustedzones alone (requirement sgx); the other fields as above under its
# prefix.
POLYGON_AMOY_UNSAFE_CHAIN_ID=80002
POLYGON_AMOY_UNSAFE_CONTRACT_ADDRESS=0x3Aa1A0d7A8A9DaE9e13345D3261afe86D67326A4
POLYGON_AMOY_UNSAFE_TRUSTEDZONE_IMAGES=<name-unsafe:sgx,...>
POLYGON_AMOY_UNSAFE_INTEGRATION_TEST_IMAGES=<name-unsafe,...>
POLYGON_AMOY_UNSAFE_TIP_PER_CU_HOUR_WEI=0
POLYGON_AMOY_UNSAFE_ACCEPT_RESERVED=true
POLYGON_AMOY_UNSAFE_FARM_INVITE=
POLYGON_AMOY_UNSAFE_FARM_ACCEPT=true
